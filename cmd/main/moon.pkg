// 可执行外壳：只负责把 `@env.args()` 交给 `mtuck/cli` 并设置退出码。
//
// 主逻辑都在 `SundayT1998/mtuck/cli`（库包），那里的 `_wbtest` 可以直接测
// `run` / `dispatch` 的返回值。本包只有一个 `main.mbt`，除“换入口符号名”外
// 不需要再改动。
import {
  "moonbitlang/core/async",
  "moonbitlang/core/env",
  "SundayT1998/mtuck/cli",
}

pkgtype(kind: "executable")

supported_targets = "native"

options(
  "allow-experimental-packages": [ "moonbitlang/core/async" ],
)
